      "reviewedSourceFingerprint": "1d2b9729d79f4e5d20a13ab319794d0d52eb3ef9978f585bae943357a0ec2ffc",
      "purpose": "Preserve current authoritative saves now while distinguishing explicitly retired pre-1.0 development formats from supported post-1.0 saves.",
      "preconditions": [
        "Every save carries explicit schema and generator identity sufficient for fail-closed validation."
      ],
      "inputs": [
        "release identity",
        "outer save schema version",
        "subsystem schema versions",
        "world generator version"
      ],
      "outputs": [
        "validated current-schema load",
        "explicit incompatible-development-save rejection",
        "deterministic supported migration after the official stable 1.0 baseline"
      ],
      "invariants": [
        "Current-schema state, identity, custody, knowledge, and cross-system consequences round-trip without duplication, reroll, or loss.",
        "Official stable 1.0 permanently latches strict forward compatibility for supported player saves.",
        "Migration failure cannot half-commit over the original stored record."
      ],
      "prohibitions": [
        "No best-effort partial legacy load or silent reset.",
        "No prerelease or later development build may disable a latched 1.0 compatibility promise."
      ],
      "exceptions": [
        "Before official stable 1.0, an obsolete internal development schema may be explicitly retired when a safe migration is not worth its cost."
      ],
      "owner": "docs/ARCHITECTURE.md#compatibility-lifecycle",
      "evidence": [
        "src/game/saveCompatibilityPolicy.test.ts",
        "src/platform/persistence.test.ts"
      ],
