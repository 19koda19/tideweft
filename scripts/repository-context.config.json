  "reviewedSummaries": [
    {
      "id": "living-voice-event-pipeline",
      "kind": "reviewed-contract-summary",
      "declaredStatus": "PARTIAL",
      "source": {
        "path": "docs/ARCHITECTURE.md",
        "locatorType": "heading",
        "locator": "Embodied acoustic event and receipt pipeline"
      },
      "reviewedSourceFingerprint": "1d2b9729d79f4e5d20a13ab319794d0d52eb3ef9978f585bae943357a0ec2ffc",
      "purpose": "Route committed vocal and physical causes through structured acoustic events, lawful listener receipts, and shared bounded presentation.",
      "preconditions": [
        "A causal domain has committed the action or experience that produced the sound."
      ],
      "inputs": [
        "stable event identity",
        "source and event-time position",
        "semantic source/action family",
        "bounded intensity, reach, duration, and repetition key"
      ],
      "outputs": [
        "environmentally propagated acoustic event",
        "listener-specific hearing receipt",
        "committed audio with optional bounded caption and world-label presentation"
      ],
      "invariants": [
        "The causal domain owns why the sound happened; presentation never creates the event.",
        "Heard-unseen receipts do not reveal exact source identity or position.",
        "Presentation suppression cannot erase lawful hearing or committed audio.",
        "Consumed ephemeral sound presentation does not replay after save/load."
      ],
      "prohibitions": [
        "No animation- or caption-authored authoritative sound.",
        "No independent domain-specific floating-sound-text system."
      ],
      "exceptions": [
        "Many lawful sounds remain audio-only when text is not salient or presentation capacity is unavailable.",
        "Current exhaustion and ordinary/serious footing choices retain bounded accepted history separate from consumed sound; other meanings remain interval-local, and broader sparse-choice/hours annoyance gates remain open."
      ],
      "owner": "docs/ARCHITECTURE.md#embodied-acoustic-event-and-receipt-pipeline",
      "evidence": [
        "src/game/worldAcoustics.test.ts",
        "src/game/physicalAcousticPerception.test.ts",
        "src/game/worldAcousticPresentation.test.ts"
      ],
      "relatedContracts": []
    },
