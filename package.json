{
  "name": "tideweft",
  "version": "0.3.3-alpha.61",
  "private": true,
  "description": "A restorative strand-type courier ecology built with p5.js and Electron.",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "vite --host 127.0.0.1 --strictPort",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "dev": "concurrently -k -n web,electron -c cyan,magenta \"npm:dev:web\" \"npm:dev:electron\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:smoke": "vitest run src/sim/simulation.test.ts src/sim/rng.test.ts src/sim/worldTime.test.ts src/sim/regions.test.ts src/game/player.test.ts src/platform/persistence.test.ts --maxWorkers=2",
    "test:context-index": "node scripts/repository-context.selftest.cjs",
    "test:player-facing-sync": "node scripts/check-player-facing-sync.selftest.cjs",
    "test:ci": "npm run test:context-index && npm run test:player-facing-sync && vitest run --maxWorkers=2",
    "context:generate": "node scripts/repository-context.cjs generate",
    "context:check": "node scripts/repository-context.cjs check",
    "context": "node scripts/repository-context.cjs context",
    "context:recover": "node scripts/repository-context.cjs recover",
    "context:stats": "node scripts/repository-context.cjs stats",
    "context:benchmark": "node scripts/repository-context.cjs benchmark",
    "patch-notes:generate": "node scripts/render-patch-notes.cjs",
    "patch-notes:check": "node scripts/render-patch-notes.cjs --check",
    "check:player-facing-sync": "node scripts/check-player-facing-sync.cjs && npm run patch-notes:check",
    "build:web": "npm run typecheck && vite build",
    "build": "npm run check:player-facing-sync && npm run test:ci && npm run build:web",
    "preview": "vite preview --host 127.0.0.1",
    "package:desktop": "npm run check:player-facing-sync && electron-forge package",
    "make:desktop": "npm run check:player-facing-sync && electron-forge make",
    "smoke:desktop": "node electron/smoke.cjs",
    "profile:baseline": "node scripts/performance-baseline.cjs",
    "profile:browser": "node scripts/browser-performance.cjs",
    "smoke:web": "node scripts/web-smoke.cjs",
    "check": "npm run check:player-facing-sync && npm run typecheck && npm run test:ci && npm run build:web && npm run smoke:web"
  },
  "dependencies": {
    "p5": "2.3.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "concurrently": "10.0.5",
    "electron": "44.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  }
}
